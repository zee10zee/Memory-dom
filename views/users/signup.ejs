<%- include('../../partials/header.ejs') %>
 <div class="container">
    <h1 style="margin: 20px auto;">Welcome ! Register </h1>
    <form action="/api/signup" method="POST" id="signupForm" enctype="multipart/form-data">
        <div class="row-left">
            <input type="text" name="username" id="username" required class="username" placeholder="Enter your name">
        <input type="text" name="lastname" id="lastname" required placeholder="Enter your last name">
        <input type="email" name="useremail" id="useremail" required placeholder="your email">
        <input type="text" name="age" id="age" required placeholder="your age please">
        <fieldset >
            <legend>Gender</legend>
            <div class="niceOutline" style="width: 100%; display: flex; align-items: center;justify-content: start;">
              <div class="radio-button" >
                <label for="male">Male</label>
                <input type="radio" id="gender" name="gender" value="male" required> 
              </div>
                  
                 <div class="radio-button">
                    <label for="female"> Female </label>
                    <input type="radio" id="gender" name="gender" value="female"> 
                 </div>
                
                 <div class="radio-button">
                    <label for="other"> Other</label>
                    <input type="radio" name="gender" id="other" value="other"> 
                 </div>
                 
            </div>
          
             </fieldset>
        </div>
      <div class="row-right" style="width: 400px;">
        <div class="birth-date niceOutline" style="width: 100%;">
            <select name="yob" id="yob"></select>
            <select name="mob" id="mob"></select>
            <select name="dayob" id="dayob"></select>
        </div><br>
        <div class="niceOutline" style="display: flex; width: 100%; margin-bottom: 10px;">
            <label for="countries" style="width: 20%;">Country</label>
            <select  name="coutries" id="countries" style="width: 80%;">
                <option value="country">country</option>
            </select>
        </div><br>

        <input type="file" name="profilePicture" id="profilePicture" accept="image/*"><br>
        <button>Sign up</button>
        <a href="/login">Already registered</a>

      </div>
        
    </form>
 </div>
<%- include('../../partials/footer.ejs') %>
